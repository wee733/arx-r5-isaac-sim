 # packages through this installer, including the visualizers and Pink IK.
-RUN ${ISAACLAB_PATH}/isaaclab.sh -i
+# Apply pins before Lab's dependency resolver: newer TensorDict upgrades torch/CUDA.
+COPY docker/runtime-constraints.txt /opt/autodata/runtime-constraints.txt
+ARG PIP_CONSTRAINT=/opt/autodata/runtime-constraints.txt
+# Keep downloads reusable if a later dependency/build step fails.
+RUN --mount=type=cache,id=arx-autodata-pip,target=/root/.cache/pip \
+    PIP_CACHE_DIR=/root/.cache/pip ${ISAACLAB_PATH}/isaaclab.sh -i
 
