+  // 这里是在“注册参数接口”：告诉框架这个组件支持哪些配置项。
+  // gxf::Expected<void> 可以理解成“这个操作可能成功，也可能失败”的结果容器。
   gxf::Expected<void> result;
+  // registrar->parameter(...) 里的 -> 叫“成员访问运算符”。
+  // 它表示：registrar 是一个指针，先找到它指向的对象，再调用这个对象的 parameter() 函数。
+  // result &= ... 里的 &= 叫“按位与并赋值”，这里不是拿来做数字运算，而是用来把多个注册结果合并起来。
+  // 可以把它理解成：前面已经有一个结果了，这次再加一个结果，最后只要有一步失败，整体就会失败。
+  // 下面这几行分别注册：文件名、分配器、输出张量、是否按彩色图像加载。
   result &= registrar->parameter(
       filename_, "filename", "Filename", "Path to PNG or JPG/JPEG image file to load",
       gxf::Registrar::NoDefaultParameter(), GXF_PARAMETER_FLAGS_OPTIONAL);
