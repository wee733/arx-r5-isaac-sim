+"""Tests for the ARX R5A manipulation metadata."""
+
+from isaac_ros_manipulation_ros_python_utils import launch_utils
+from isaac_ros_manipulation_ros_python_utils.manipulator_types import (
+    GripperType, RobotType,
+)
+
+
+def _patch_launch_values(monkeypatch, values):
+    monkeypatch.setattr(
+        launch_utils,
+        'get_str_variable',
+        lambda _context, name: values[name],
+    )
+
+
+def test_arx_r5a_robot_type_and_joint_names(monkeypatch):
+    """Resolve R5A identity, prefix, and six arm joints."""
+    _patch_launch_values(monkeypatch, {
+        'robot_type': 'ARX_R5A',
+        'tf_prefix': '',
+    })
+
+    assert launch_utils.get_robot_type(None) is RobotType.ARX_R5A
+    assert launch_utils.compute_frame_prefix(None) == ''
+    assert launch_utils.compute_joint_names(None) == [
+        'joint1', 'joint2', 'joint3', 'joint4', 'joint5', 'joint6'
+    ]
+
+
+def test_arx_r5a_gripper_metadata():
+    """Resolve the R5A GripperCommand interface and positions."""
+    assert GripperType.get_gripper_type('arx_r5a') is GripperType.ARX_R5A
+    assert launch_utils.compute_gripper_action_name('arx_r5a') == (
+        '/gripper_controller/gripper_cmd'
+    )
+    assert launch_utils.compute_gripper_positions('arx_r5a') == (0.044, 0.0)
